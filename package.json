{
  "name": "buenos-aires-hidden-city",
  "private": true,
  "version": "1.0.0",
  "description": "An offline-first, installable treasure-hunt tour of Buenos Aires for two.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "narration:export": "tsx scripts/export-narration.ts",
    "icons": "node scripts/generate-icons.mjs",
    "narration:render": "python3 scripts/tts/build_narration.py"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@preact/signals": "2.11.3",
    "idb": "8.0.4",
    "preact": "10.29.8",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "fake-indexeddb": "6.2.5",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-build": "7.4.1"
  }
}
